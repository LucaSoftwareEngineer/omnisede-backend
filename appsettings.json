{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "%JWT_ISSUER%",
    "Audience": "%JWT_AUDIENCE%",
    "SecretKey": "%JWT_SECRET_KEY%",
    "AccessTokenExpirationMinutes": 30
  },
  "ConnectionStrings": {
    "DefaultConnection": "%DB_CONN%"
  },
  "Blob": {
    "BlobConn": "%BLOB_CONN%",
    "BlobContainer": "%BLOB_CONTAINER%"
  },
  "Smtp": {
    "Host": "%SMTP_HOST%",
    "Port": "%SMTP_PORT%",
    "NameSender": "%SMTP_NAME_SENDER%",
    "MailSender": "%SMTP_MAIL_SENDER%",
    "MailToken": "%SMTP_MAIL_TOKEN%"
  }
}

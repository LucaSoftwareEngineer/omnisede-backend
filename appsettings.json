{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "%JWT_ISSUER%",
    "Audience": "%JWT_AUDIENCE%",
    "SecretKey": "%JWT_SECRET_KEY%",
    "AccessTokenExpirationMinutes": 30
  },
  "ConnectionStrings": {
    "DefaultConnection": "%DB_CONN%"
  }
}
